{
  "name": "openmusicapi",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "dev": "NODE_ENV=development node --watch --env-file=.env src/server.js",
    "start": "NODE_ENV=production node --env-file=.env src/server.js",
    "test": "newman run test/v2/OpenMusicAPIV2Test.postman_collection.json -e test/v2/OpenMusicAPITest.postman_environment.json",
    "test:folder": "newman run test/v2/OpenMusicAPIV2Test.postman_collection.json -e test/v2/OpenMusicAPITest.postman_environment.json --folder",
    "reset": "npm run migrate down --count 10 && npm run migrate up",
    "migrate": "node-pg-migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-dicodingacademy": "^0.9.4",
    "globals": "^15.14.0"
  },
  "dependencies": {
    "@hapi/hapi": "^21.3.12",
    "@hapi/jwt": "^3.2.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "joi": "^17.13.3",
    "nanoid": "^3.3.8",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1"
  }
}
